# Copie para ".env.local" e ajuste conforme o ambiente.

# Endereço base da API (sem barra no final). O padrão "/api" usa o mesmo domínio do site:
# no "npm run dev" o Vite repassa /api para a API local; em produção, publique o site e a API
# no mesmo domínio (a API pode servir o build — veja o README do Pawtinhas-Back).
VITE_API_URL=/api

# Para onde o servidor de desenvolvimento repassa /api.
VITE_API_PROXY=http://localhost:5135

# WhatsApp da clínica para o botão "Ir para o WhatsApp" (somente dígitos, com DDI e DDD,
# ex.: 5534912345678). Sem um número válido, os botões de WhatsApp ficam ocultos.
VITE_WHATSAPP=
